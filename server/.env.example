# ============================================================
# SP Smart Broadcast Server — Environment Configuration
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=8080
# Cloudflare Tunnel e o Node rodam no mesmo aparelho.
HOST=127.0.0.1

# --- WebSocket ---
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL_MS=5000
WS_CLIENT_TIMEOUT_MS=15000

# --- Security ---
# Comma-separated list of allowed origins (use * for dev only)
CORS_ORIGINS=*
# Pre-shared key for authenticating reporter connections
AUTH_SECRET=change-me-in-production

# DNS publico usado pelo app no URL de ingest SRT. Este hostname precisa de
# alcance UDP direto ate 8890; um Tunnel HTTP comum atende somente o WSS.
SRT_PUBLIC_HOST=srt-direct.syncplayer.com.br

# --- MediaMTX Integration ---
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_API_USER=admin
MEDIAMTX_API_PASS=password
# SRT listening port (configured in MediaMTX)
SRT_PORT=8890

# --- NDI / Playout ---
# Leave empty to disable NDI push notifications
NDI_SOURCE_PREFIX=SP-Smart

# --- Logging ---
LOG_LEVEL=debug
