    "@types/express": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "ts-node-dev": "^2.0.0",
    "eslint": "^9.21.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "jest": "^29.7.0",
